# ── Discord ──────────────────────────────────────────────────────────────────
# Token du bot (onglet "Bot" dans le Developer Portal)
DISCORD_TOKEN=

# Application ID (onglet "General Information" dans le Developer Portal)
DISCORD_CLIENT_ID=

# Optionnel : ID d'un serveur spécifique pour un enregistrement instantané des
# commandes en développement. Laisser vide pour un enregistrement global (prod).
DISCORD_GUILD_ID=

# ── Base de données ───────────────────────────────────────────────────────────
# Injecté automatiquement par Railway en production.
# Pour le dev local avec docker-compose :
DATABASE_URL=postgres://bot:bot@localhost:5432/dofus_tracker
